FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace

COPY pom.xml .
COPY shared/pom.xml shared/
COPY appointment-service/pom.xml appointment-service/

RUN mvn -q -pl appointment-service -am dependency:go-offline

COPY shared shared
COPY appointment-service appointment-service

RUN mvn -q -pl appointment-service -am clean package -DskipTests

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /workspace/appointment-service/target/*.jar app.jar

EXPOSE 8083
ENTRYPOINT ["java", "-jar", "app.jar"]